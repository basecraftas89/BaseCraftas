:root{--ink:#162f2b;--green:#214c37;--terra:#ad4f31;--sub:#52625e;--line:#d7dfda;--soft:#f4f6f3;--paper:#fff;--r:8px;--max:1160px}*{box-sizing:border-box}html{scroll-padding-top:112px}body{margin:0;color:var(--ink);font-family:'Noto Sans JP',-apple-system,BlinkMacSystemFont,'Hiragino Kaku Gothic ProN','Yu Gothic',sans-serif;font-size:17px;line-height:1.85;background:var(--paper)}a{color:var(--green);text-underline-offset:5px}a:hover{text-decoration-thickness:2px}button{font:inherit}a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #b56a28;outline-offset:5px}img{max-width:100%;height:auto;display:block}h1,h2,h3,p{margin:0}h1,h2,h3{line-height:1.45;letter-spacing:.01em}h1{font-size:clamp(36px,4.5vw,58px);font-weight:750;line-height:1.5}h2{font-size:clamp(27px,3vw,36px);font-weight:700}h3{font-size:22px}p{color:var(--sub)}p+p{margin-top:16px}.wrap{width:min(var(--max),calc(100% - 64px));margin:auto}.skip{position:fixed;top:-100px;left:20px;z-index:20;background:white;padding:12px}.skip:focus{top:12px}.site-header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}.header-inner{max-width:1400px;padding:20px 32px;margin:auto;display:flex;align-items:center;gap:28px;min-height:88px}.brand{margin-right:auto;flex-shrink:0}.brand img{width:142px;height:53px;object-fit:contain}.nav{display:flex;gap:22px;align-items:center}.nav a{font-size:14px;text-decoration:none;white-space:nowrap;padding:9px 0;color:var(--ink)}.nav a[aria-current]{border-bottom:2px solid var(--green);font-weight:700}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:11px 25px;background:var(--green);color:#fff;border:1px solid var(--green);border-radius:4px;font-weight:700;text-decoration:none;line-height:1.5;gap:16px}.button:hover{background:#173d2a;text-decoration:none}.button.secondary{color:var(--terra);background:white;border-color:var(--terra)}.button.terra{background:var(--terra);border-color:var(--terra)}.contact-head{font-size:14px;white-space:nowrap}.menu-button{display:none;background:white;border:1px solid var(--line);padding:8px 12px;border-radius:4px}.breadcrumb{font-size:14px;color:var(--sub);padding-top:27px}.breadcrumb a{color:var(--sub)}.hero{background:#f7f8f5;padding:62px 0 68px}.hero-grid{display:grid;grid-template-columns:1.07fr 1fr;gap:54px;align-items:center}.eyebrow{font-size:13px;color:var(--green);font-weight:700;letter-spacing:.12em;display:block;margin-bottom:17px}.hero p{margin-top:22px;max-width:580px;font-size:18px}.hero-art{width:100%;max-height:395px;object-fit:contain}.hero-art.portrait{width:320px;justify-self:center;border-radius:12px}.actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:29px}.section{padding:78px 0}.section.soft{background:var(--soft)}.section-head{max-width:730px;margin-bottom:34px}.section-head.center{margin:0 auto 36px;text-align:center}.section-head p{margin-top:14px}.grid{display:grid;gap:24px}.three{grid-template-columns:repeat(3,minmax(0,1fr))}.four{grid-template-columns:repeat(4,minmax(0,1fr))}.two{grid-template-columns:repeat(2,minmax(0,1fr))}.card{border:1px solid var(--line);border-radius:var(--r);background:white;overflow:hidden}.card-body{padding:25px}.card p{font-size:16px;margin-top:14px}.card h3+p{margin-top:12px}.card-art{height:205px;width:100%;object-fit:contain;background:#fafbf8;padding:18px}.service-en{display:block;font-size:14px;font-weight:700;color:var(--green);margin:10px 0 8px}.text-link{display:inline-block;margin-top:22px;font-weight:700;color:var(--terra)}.number{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;color:white;background:var(--green);font-size:16px;font-weight:700;margin-bottom:20px}.step{padding:26px;background:white;border:1px solid var(--line);border-radius:var(--r)}.step h3{font-size:20px}.step p{margin-top:12px;font-size:16px}.step-icon{width:40px;height:40px;margin:2px 0 20px;color:var(--green)}.split{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.split-image{max-height:350px;object-fit:contain;justify-self:center}.split p{margin-top:20px}.core-quote{font-size:clamp(24px,3vw,32px);font-weight:700;line-height:1.65;color:var(--ink)}.profile-mini{display:flex;gap:24px;align-items:center}.profile-mini img{width:140px;border-radius:8px}.project-logo{height:210px;width:100%;padding:25px;object-fit:contain;background:white}.status{display:inline-block;font-size:13px;line-height:1.5;padding:6px 10px;border-radius:4px;background:#e9eeea;color:var(--green);font-weight:700}.project-card .status{margin:24px 24px 0}.project-wide{display:grid;grid-template-columns:1fr 1.2fr;padding:30px;gap:45px;align-items:center;margin-bottom:24px}.project-wide .project-logo{height:260px;padding:0}.project-wide p{margin-top:15px}.project-wide .status{margin-bottom:18px}.faq{max-width:850px;margin:auto}.faq details{border-top:1px solid var(--line);padding:0 4px}.faq details:last-child{border-bottom:1px solid var(--line)}.faq summary{cursor:pointer;font-size:18px;font-weight:600;padding:22px 32px 22px 0;position:relative;list-style:none}.faq summary::-webkit-details-marker{display:none}.faq summary::after{content:'＋';position:absolute;right:4px;font-weight:400}.faq details[open] summary::after{content:'−'}.faq details p{padding:0 20px 24px 0;font-size:16px}.consult{padding:47px 0;background:var(--green);color:white}.consult .wrap{display:flex;align-items:center;justify-content:space-between;gap:35px}.consult h2{font-size:28px}.consult p{color:#e0e8df;margin-top:9px}.site-footer{padding:42px 0 25px;border-top:1px solid var(--line)}.footer-top{display:flex;gap:50px;justify-content:space-between;align-items:flex-start}.footer-top img{width:145px}.footer-nav{display:grid;grid-template-columns:repeat(3,auto);gap:10px 30px}.footer-nav a{font-size:14px;color:var(--sub)}.footer-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:35px;font-size:12px;color:var(--sub)}.footer-bottom a{font-size:13px;color:var(--sub)}.icon{display:block;width:42px;height:42px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.icon-box{width:76px;height:76px;display:grid;place-items:center;background:#edf1ec;border-radius:8px;margin-bottom:22px}.feature{padding:27px}.feature p{font-size:16px;margin-top:12px}.label-list{margin:21px 0 0;display:grid;grid-template-columns:62px 1fr;gap:12px;font-size:15px}.label-list dt{font-weight:700}.label-list dd{margin:0;color:var(--sub)}.plain-list{padding-left:23px;color:var(--sub);margin:20px 0 0}.plain-list li{margin:8px 0}.note{padding:21px 24px;border-left:4px solid var(--green);background:#edf1ec;font-size:15px;color:var(--sub);margin-top:25px}.period{font-size:40px;color:var(--green);font-weight:700;line-height:1.2;margin-bottom:12px}.period small{font-size:20px}.table-scroll{overflow:auto;border:1px solid var(--line);border-radius:6px}table{width:100%;border-collapse:collapse;text-align:left;font-size:15px}th,td{padding:18px;border-bottom:1px solid var(--line);vertical-align:top;min-width:150px}th{background:#edf1ec}tr:last-child td,tr:last-child th{border-bottom:0}.definition{display:grid;grid-template-columns:130px 1fr;border-top:1px solid var(--line);margin:30px 0 0}.definition dt,.definition dd{padding:17px 0;border-bottom:1px solid var(--line);margin:0}.definition dt{font-weight:700}.definition dd{color:var(--sub)}.timeline{list-style:none;padding:0;margin:0;display:grid;gap:18px}.timeline li{display:grid;grid-template-columns:130px 1fr;border:1px solid var(--line);border-radius:6px;padding:24px;gap:24px}.timeline strong{color:var(--green)}.timeline h3{font-size:20px}.timeline p{font-size:16px;margin-top:8px}.product-symbol{height:180px;display:grid;place-items:center;background:#f7f8f5;color:var(--green)}.product-symbol .icon{width:78px;height:78px;stroke-width:1.4}.product .status{margin-top:15px}.product h3{font-size:26px}.product p{font-size:16px}.center-text{text-align:center}.section-short{padding:50px 0}.page-intro{max-width:750px}.section-head .eyebrow{margin-bottom:10px}.pillars .card{padding:30px}.pillars h3{font-size:24px}.pillars p{font-size:16px;margin-top:18px}.brand-mark{max-width:200px;margin:0 auto 26px}.manual{display:grid;grid-template-columns:70px 1fr;gap:22px;align-items:center;border:1px solid var(--line);padding:26px;background:#fff;border-radius:8px}.manual .icon{width:55px;height:55px}.menu-button[aria-expanded=true]{border-color:var(--green)}
@media(max-width:1100px){.header-inner{padding:16px 24px;gap:20px}.nav{gap:14px}.nav a{font-size:13px}.brand img{width:120px}.button.contact-head{padding:11px 16px}.hero-grid{gap:30px}}
@media(max-width:900px){.menu-button{display:block}.header-inner{min-height:76px}.nav{display:none;position:absolute;left:0;right:0;top:100%;padding:16px 24px 26px;background:white;border-bottom:1px solid var(--line)}.nav.open{display:grid;gap:0}.nav a{font-size:16px;padding:13px 0}.nav a[aria-current]{border-bottom:0;color:var(--green);font-weight:700}.hero-grid{grid-template-columns:1fr 1fr;gap:20px}.four{grid-template-columns:repeat(2,1fr)}.three{gap:16px}.card-body{padding:20px}.card-art{height:170px}.wrap{width:calc(100% - 40px)}}
@media(max-width:680px){body{font-size:16px}.header-inner{padding:12px 18px;gap:12px}.brand img{width:110px;height:43px}.contact-head{display:none}.menu-button{margin-left:auto;min-height:44px}.wrap{width:calc(100% - 40px)}.hero{padding:42px 0 45px}.hero-grid{grid-template-columns:1fr;gap:25px}h1{font-size:34px}.hero p{font-size:16px;margin-top:18px}.hero-art{max-height:285px}.hero-art.portrait{width:230px}.hero .actions .button{flex:1;white-space:nowrap;padding-left:16px;padding-right:16px}.section{padding:54px 0}.three,.four,.two,.split{grid-template-columns:1fr}.grid{gap:19px}.split{gap:30px}.section-head{margin-bottom:26px}.section-head.center{text-align:left;margin-bottom:26px}.card-art{height:210px}.project-wide{grid-template-columns:1fr;padding:24px;gap:24px}.project-wide .project-logo{height:230px}.consult .wrap{display:block}.consult h2{font-size:25px}.consult .button{margin-top:24px;width:100%}.footer-top{display:block}.footer-nav{margin-top:30px;grid-template-columns:repeat(2,1fr);gap:12px 20px}.footer-bottom{display:block}.footer-bottom div+div{margin-top:13px}.timeline li{grid-template-columns:1fr;gap:8px;padding:20px}.definition{grid-template-columns:90px 1fr;font-size:15px}.profile-mini img{width:105px}.product-symbol{height:145px}.step{padding:24px}.hero-art.group{max-height:270px}.breadcrumb{padding-top:22px}.manual{grid-template-columns:45px 1fr}.manual .icon{width:40px;height:40px}.note{padding:18px}.hero-grid .eyebrow{margin-bottom:14px}}

.nav .mobile-contact{display:none}@media(max-width:900px){.nav.open .mobile-contact{display:block;color:var(--terra);font-weight:700}}

.service-list{display:grid;gap:28px}.service-list .service-row{display:grid;grid-template-columns:minmax(240px,.8fr) minmax(0,1.3fr);align-items:center}.service-list .card-art{height:290px;padding:24px;object-fit:contain}.service-list .card-body{padding:32px 38px}.service-list h3{font-size:27px}.service-summary{border-top:1px solid var(--line);padding-top:17px}.service-summary strong{display:block;color:var(--ink)}.service-target{font-size:14px!important}.profile-credentials,.handover-map{padding:35px;background:#edf1ec;border-radius:8px}.profile-credentials ul{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0;margin:24px 0 0}.profile-credentials li{padding:12px;background:white;border:1px solid var(--line);border-radius:4px;font-size:16px}.handover-map ol{padding-left:24px;margin-top:24px}.handover-map li{padding:16px 8px;border-bottom:1px solid var(--line)}@media(max-width:680px){.service-list .service-row{grid-template-columns:1fr}.service-list .card-art{height:210px}.service-list .card-body{padding:22px}.service-list h3{font-size:24px}.profile-credentials{padding:24px}.profile-credentials ul{grid-template-columns:1fr}.profile-credentials li{font-size:16px}}

.service-overview-symbol{height:125px;display:grid;place-items:center;background:#edf1ec;color:var(--green)}.service-overview-symbol .icon{width:64px;height:64px}

.hero-projects h1,.hero-products h1{font-size:clamp(28px,3.6vw,46px);line-height:1.5}
